{
  "name": "@templatical/ai-kit",
  "description": "Bring your own AI backend to the Templatical email editor: the wire, an HTTP provider, a server kit with prompts and tools, and a conformance suite",
  "version": "0.50.0",
  "bugs": "https://github.com/templatical/sdk/issues",
  "dependencies": {
    "@templatical/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./prompts/*": "./prompts/*",
    "./schema/*": "./schema/*",
    "./eval/*": "./eval/*"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "prompts",
    "schema",
    "eval"
  ],
  "homepage": "https://templatical.com",
  "keywords": [
    "ai",
    "email",
    "email-editor",
    "llm",
    "server-sent-events",
    "templatical"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/templatical/sdk.git",
    "directory": "packages/ai-kit"
  },
  "scripts": {
    "build": "tsdown",
    "eval:manifest": "node scripts/eval-manifest.mjs",
    "generate-assets": "node scripts/generate-assets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
