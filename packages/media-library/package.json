{
  "name": "@templatical/media-library",
  "description": "Media library management for Templatical email editor",
  "version": "0.39.0",
  "bugs": "https://github.com/templatical/sdk/issues",
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@templatical/types": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "vue-advanced-cropper": "^2.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/templatical-media-library.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://templatical.com",
  "keywords": [
    "asset-manager",
    "image-upload",
    "media-library",
    "media-manager",
    "templatical",
    "vue"
  ],
  "license": "FSL-1.1-MIT",
  "module": "./dist/templatical-media-library.js",
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/templatical/sdk.git",
    "directory": "packages/media-library"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && api-extractor run --local && rm -rf dist/types",
    "build:all": "pnpm run build && vite build --config vite.cdn.config.ts",
    "build:cdn": "vite build --config vite.cdn.config.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
