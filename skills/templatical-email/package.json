{
  "name": "@templatical/email-skill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Skill: generate and validate Templatical email template JSON",
  "license": "MIT",
  "scripts": {
    "bundle-vendor": "pnpm --filter @templatical/types --filter @templatical/quality build && node tools/bundle-vendor.mjs",
    "generate-schema": "node tools/generate-schema.mjs",
    "sync-editor-version": "node tools/sync-editor-version.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "ts-json-schema-generator": "^2.9.0",
